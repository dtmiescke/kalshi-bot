# Copy to .env (never commit it). On GitHub, add these as repository Secrets.
BOT_MODE=paper                 # paper | demo | live
LIVE_TRADING_CONFIRMED=no      # must be "yes" for live; leave "no"

# Kalshi DATA key: from your REAL account (no deposit), read-only use for the live
# WebSocket price feed. Strongly recommended even in paper mode.
KALSHI_DATA_KEY_ID=
KALSHI_DATA_PRIVATE_KEY=

# Kalshi TRADING key: DEMO key in demo mode, real key only in live mode
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=            # full PEM text; newlines may be written as \n

# The Odds API free key: https://the-odds-api.com  (sportsbook consensus)
ODDS_API_KEY=
ODDS_REGIONS=us                # "us,eu" adds Pinnacle but costs 2x credits
ODDS_REFRESH_MINUTES=360

# OpenRouter free models (AI news reader)
OPENROUTER_API_KEY=
# comma-separated panel, tried in order; check openrouter.ai/models for current :free ones
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free,qwen/qwen-2.5-72b-instruct:free
LLM_DAILY_LIMIT=45
LLM_MAX_CALLS_PER_RUN=6
LLM_MINIMALISM_ENABLED=yes      # concise AI replies; no change to risk rules or required JSON fields

# Risk (dollars)
BANKROLL=1000
MAX_PER_BET=25
MAX_PER_GAME=50
MAX_PER_DAY=150
MIN_EDGE=3                     # % edge needed after fees
MIN_CONFIDENCE=55              # % confidence needed
KELLY_FRACTION=0.25

# Crypto 15-minute markets
CRYPTO_ENABLED=yes
CRYPTO_MIN_EDGE=5              # % edge needed on 15-min crypto
CRYPTO_MIN_BET=15              # crypto trades below this stake are skipped, never downsized
CRYPTO_MAX_TRADES_PER_HOUR=10   # maximum entries/hour across BTC+ETH+SOL; not a forced quota
CRYPTO_MAX_PER_BET=20           # total budget includes fees; must fit minimum stake + fees

# Circuit breaker: pause betting if 7-day losses exceed this share of bankroll
MAX_DRAWDOWN=10                # % of bankroll

# Live mode
COUNCIL_MODE=advisory          # advisory | required | off
SETTLE_AVG_SECONDS=60          # used only if a contract's rules don't state it
SPORTS_EVERY_HOURS=5.5         # sports scan interval for the 12-min schedule
BRIEFING_EVERY_MINUTES=12
LLM_RESERVE_FOR_TRADING=10     # daily AI calls kept for news + council
SPORTS_EVERY_MINUTES=12        # only used by optional live streaming mode

# Execution
ORDER_STYLE=maker              # maker (limit inside spread, live bursts) | taker
MAKER_WAIT_SECONDS=45
MAKER_FEE_RATE=0.0175          # check Kalshi's fee schedule
FIXED_BET=                     # e.g. 5 = always $5 per bet (still capped); empty = size by edge
EXITS_ENABLED=yes
EXIT_MARGIN=2                  # % the bid must beat holding before selling early
CRYPTO_MAX_PER_WINDOW=100      # $ across BTC+BNB+ETH+SOL in one synchronized 15-minute window
CRYPTO_LADDER_SERIES=KXBTCD,KXETHD   # hourly/daily ladders for arbitrage; verify tickers

# Schedule + learning
BURST_MINUTES=8                # live streaming per 12-minute run (0 = snapshot only)
TRAIN_EVERY_HOURS=168
ML_MIN_WINDOWS=300             # settled windows needed before training

# Phone alerts (free ntfy app; pick a long random topic)
NTFY_TOPIC=
BRIEFING_ALERTS=no

# Audit safeguards (see FLAWS.md)
SETTLE_PROXY_BPS=3             # gap between our price and Kalshi's settlement index
ODDS_MAX_AGE_MINUTES=60        # never compare Kalshi with older sportsbook lines
MAX_FEED_DIVERGENCE_BPS=25     # Kraken vs Coinbase disagreement = stale data
RECOVERY_DAYS=21               # pauses/benches judge only recent results
SIM_SLIPPAGE=0.005             # $ per contract charged in simulations
ML_MIN_TEST_WINDOWS=100        # unseen windows required before promotion

# Ladders (hourly/daily "above $X" crypto markets)
LADDERS_ENABLED=yes
LADDER_MIN_EDGE=8              # % — stricter than 15-min, no trained model here
LADDER_MAX_PER_BET=5
LADDER_MIN_MINUTES=20
LADDER_MAX_MINUTES=240
MIN_MAKER_FILL_RATE=0.25       # below this, take the ask instead of resting

# Optional Val Town bridge for non-time-critical public metadata only
# Keep the HTTP val private. Live WebSockets, books/trades, account data, and orders stay direct.
VAL_TOWN_KALSHI_URL=
ATI_INGEST_SHARED_TOKEN=

# Optional: self-hosted OmniRoute gateway (tried first; falls back to OpenRouter)
OMNIROUTE_URL=                 # e.g. https://your-host/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODELS=auto          # model/combo names from your OmniRoute dashboard

# Optional: LiteLLM Proxy gateway (OmniRoute remains first; OpenRouter remains fallback)
LITELLM_URL=                 # e.g. https://your-litellm-host/v1
LITELLM_API_KEY=
LITELLM_MODELS=               # comma-separated aliases configured in your LiteLLM proxy

# Account limits
MAX_OPEN_POSITIONS=5
MAX_OPEN_COST=200
DAILY_LOSS_LIMIT=30

# Demo day only: price trades against the demo exchange's own books
# KALSHI_DATA_URL=https://external-api.demo.kalshi.co/trade-api/v2
